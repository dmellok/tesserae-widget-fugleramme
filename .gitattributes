# Kept out of the release tarball GitHub builds from a tag: the catalog serves
# screenshots from its own repo, and server.py imports neither the tests nor
# the tools. Tesserae refuses widget tarballs over 4 MiB.
screenshots/ export-ignore
tests/ export-ignore
tools/ export-ignore
ruff.toml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
